# مفتاح توقيع التراخيص — تسرّبه يعني أن غيرك يُصدر أكوادًا
license_private.key

# بيئات وذاكرة مؤقتة
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ثنائيات مشحونة — تُجلب بـ tools/setup_ffmpeg.py ولا تدخل المستودع
bin/
models/
# مُشتقّة من الشعار — تُولَّد بـ tools/make_icon.py
assets/logo.ico

# وسائط للاختبار توضع في مجلّد المشروع. دخلت مرّةً إلى المستودع
# بالخطأ (‏67 ميغابايت في الدفعة f990928): تسجيلات محاضرات فيها أصوات
# زملاء، وهي ملفّات المستخدم لا مصدر البرنامج.
*.mp4
*.mkv
*.mov
*.avi
*.m4a
*.mp3
*.wav
*.srt

# نواتج التشغيل
logs/
temp/
output/
dist/
build/
testdata/corpus/
acceptance_out/
*.spec.bak

# مجلدات مهام أُنتجت داخل المشروع (يحدث إن ضُبط مجلد الحفظ هنا)
*/job_state.json

# نواتج القياس والقبول (تُولَّد بالتشغيل)
acceptance_report.json
asr_benchmark.json
wer_*.json

# إعداد محلي قد يحوي مفاتيح
config.local.yaml
.env

# نظام التشغيل
Thumbs.db
desktop.ini
.DS_Store

# حزم Git الاحتياطية — ‏_backup-before-purge.bundle وحده 66MB، وهو
# نسخة التاريخ **قبل** تنظيفه من تسجيلات المحاضرات. دفعُه بـ
# ``git add -A`` يعيد إلى المستودع بالضبط ما أُخرج منه.
*.bundle

# مفتاح توقيع التراخيص الخاصّ. من يملكه يُصدر أكوادًا لأي مدّة ولأي
# جهاز، فتسقط المنظومة كلها — ولا يُلغى بإلغاء كود. يبقى خارج المستودع
# مهما فعل ``git add -A``. النسخة العامّة منه في ``licensing/keys.py``
# وهي التي تُشحن مع البرنامج.
license_private.key
*.pem
*.key
